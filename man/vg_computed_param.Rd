\code{max()}, \code{sum()}, \code{round()}, \code{abs()}, \code{sqrt()}, \code{exp()}, \code{ln()},
\code{median()}, \code{quantile_cont()}.
\item \code{\link[=sql]{sql()}} inserts raw SQL, with params written as \verb{$name}.
