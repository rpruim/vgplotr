.Rproj.user
.Rhistory
.RData
.Ruserdata

design/

# Quarto render artifacts
/.quarto/
vignettes/*.html
vignettes/*_files/
vignettes/*_cache/
vignettes/.quarto/

# JS bundle build tooling (data-raw/js/build.js) -- its *output*,
# inst/htmlwidgets/lib/mosaic-bundle.min.js, is committed; the node_modules
# used to produce it are not.
data-raw/js/node_modules/
inst/doc
**/.quarto/

# pkgdown build output -- regenerate with pkgdown::build_site(); deploy via
# a gh-pages workflow rather than committing built HTML to main.
docs/

**/*.quarto_ipynb

# rmarkdown::render()'s local HTML preview of README.Rmd -- README.md
# (committed) is the real output; this is just a render byproduct.
README.html

# htmlwidget byproducts of knitting README.Rmd (a copy of each widget's HTML and of
# its JS/CSS dependencies). README.md only uses the .png figures, so these are
# neither tracked nor shipped. They are also in .Rbuildignore: a gitignored file
# is still bundled by a build from a local directory.
man/figures/README-*.html
man/figures/README-*_files/
